{
  "name": "ritsei",
  "private": true,
  "description": "Open-source enterprise business platform for running operations and designing how they run.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "start": "varlock run -- tsx runtime/api/mod.ts",
    "dev": "varlock run -- tsx watch runtime/api/mod.ts",
    "worker": "varlock run -- tsx runtime/worker/mod.ts",
    "auth:bootstrap": "varlock run -- tsx runtime/auth/bootstrap.ts",
    "p0:backfill": "varlock run -- tsx runtime/migrator/p0-backfill.ts",
    "migrate": "varlock run -- tsx runtime/migrator/mod.ts",
    "db:generate": "varlock run -- drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "pnpm run migrate",
    "db:check": "varlock run -- drizzle-kit check --config=drizzle.config.ts",
    "document:benchmark": "varlock run -- tsx tooling/document-rendering/benchmark.ts",
    "contracts": "varlock run -- pnpm --filter @ritsei/web run contracts",
    "styles": "pnpm --filter @ritsei/web run styles",
    "test": "varlock run -- pnpm run contracts && varlock run -- vitest run",
    "test:related": "varlock run -- vitest related --run",
    "check:affected": "varlock run -- tsx tooling/affected-check.ts",
    "test:coverage": "varlock run -- vitest run --coverage --coverage.provider=v8",
    "test:identity-coverage": "varlock run -- vitest run --coverage --coverage.provider=v8 --coverage.include=modules/identity/src/**/*.ts --coverage.thresholds.100 modules/identity/tests",
    "test:contract": "varlock run -- vitest run --config vitest.contract.config.ts",
    "lefthook:install": "lefthook install",
    "fallow": "npx --no-install fallow",
    "fallow:audit": "npx --no-install fallow audit --format json --quiet",
    "fallow:dead-code": "npx --no-install fallow dead-code",
    "fallow:dupes": "npx --no-install fallow dupes",
    "fallow:health": "npx --no-install fallow health",
    "fallow:boundaries": "npx --no-install fallow dead-code --boundary-violations",
    "fallow:fix:dry-run": "npx --no-install fallow fix --dry-run",
    "skills:check": "tsx tooling/check-agent-skills.ts",
    "release:metadata": "varlock run -- tsx tooling/release-check.ts",
    "fmt:check": "oxfmt --check --no-error-on-unmatched-pattern \"**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,json5}\"",
    "fmt": "oxfmt --write --no-error-on-unmatched-pattern \"**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,json5}\"",
    "lint": "oxlint --disable-nested-config --deny-warnings --report-unused-disable-directives .",
    "release:check": "pnpm run fmt:check && pnpm run lint && pnpm run check && pnpm run db:check && pnpm run skills:check && pnpm run boundary:test && pnpm run boundary:lint && pnpm run test && pnpm run fallow:audit",
    "architecture:check": "varlock run -- tsx tooling/architecture.ts",
    "financial:gate": "varlock run -- tsx tooling/financial-gate.ts",
    "boundary:lint": "varlock run -- ast-grep scan apps foundation modules platform runtime tooling tests && pnpm run fallow:boundaries && pnpm run architecture:check && varlock run -- tsx tooling/schema-ownership.ts",
    "postgres19:rehearse": "varlock run -- tsx tooling/postgresql-19/rehearse.ts",
    "production:artifacts": "varlock run -- tsx tooling/production/artifacts.ts",
    "boundary:test": "ast-grep test --skip-snapshot-tests",
    "check": "varlock run -- pnpm run contracts && varlock run -- pnpm run styles && varlock run -- tsc --noEmit -p tsconfig.json && varlock run -- pnpm --filter @ritsei/web run check"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0",
    "@effect/platform-node-shared": "4.0.0",
    "@effect/sql-pg": "4.0.0",
    "drizzle-orm": "1.0.0-rc.5-169397b",
    "effect": "4.0.0",
    "pdfnative": "1.7.0",
    "postgres": "3.4.7",
    "tigerbeetle-node": "0.17.9",
    "uuid": "14.0.3",
    "varlock": "1.23.0"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.0",
    "@axe-core/playwright": "4.13.0",
    "@effect/vitest": "4.0.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "5.0.2",
    "drizzle-kit": "1.0.0-rc.4",
    "esbuild": "0.28.0",
    "fallow": "3.20.0",
    "lefthook": "2.1.15",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=24.22.0"
  },
  "packageManager": "pnpm@12.14.0"
}
