{
  "name": "ritsei",
  "description": "Open-source enterprise business platform for running operations and designing how they run.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.22.0"
  },
  "dependencies": {
    "effect": "4.0.0",
    "@effect/platform-node": "4.0.0",
    "@effect/platform-node-shared": "4.0.0",
    "@effect/sql-pg": "4.0.0",
    "uuid": "14.0.3",
    "drizzle-orm": "1.0.0-rc.5-169397b",
    "pdfnative": "1.7.0",
    "postgres": "3.4.7",
    "tigerbeetle-node": "0.17.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "esbuild": "0.28.0",
    "@types/node": "^24.19.2",
    "@ast-grep/cli": "0.51.0",
    "tsx": "4.23.15",
    "dprint": "0.63.0",
    "@effect/vitest": "4.0.0",
    "@vitest/coverage-v8": "5.0.2",
    "drizzle-kit": "1.0.0-rc.4",
    "fallow": "3.20.0",
    "lefthook": "2.1.15",
    "vitest": "5.0.2"
  },
  "scripts": {
    "start": "tsx runtime/api/mod.ts",
    "dev": "tsx watch runtime/api/mod.ts",
    "worker": "tsx runtime/worker/mod.ts",
    "auth:bootstrap": "tsx runtime/auth/bootstrap.ts",
    "p0:backfill": "tsx runtime/migrator/p0-backfill.ts",
    "migrate": "tsx runtime/migrator/mod.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "pnpm run migrate",
    "db:check": "drizzle-kit check --config=drizzle.config.ts",
    "document:benchmark": "tsx tooling/document-rendering/benchmark.ts",
    "contracts": "pnpm --filter @ritsei/web run contracts",
    "styles": "pnpm --filter @ritsei/web run styles",
    "test": "pnpm run contracts && vitest run",
    "test:related": "vitest related --run",
    "check:affected": "tsx tooling/affected-check.ts",
    "test:coverage": "vitest run --coverage --coverage.provider=v8",
    "test:identity-coverage": "vitest run --coverage --coverage.provider=v8 --coverage.include=modules/identity/src/**/*.ts --coverage.thresholds.100 modules/identity/tests",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "lefthook:install": "lefthook install",
    "fallow": "npx --no-install fallow",
    "fallow:audit": "npx --no-install fallow audit --format json --quiet",
    "fallow:dead-code": "npx --no-install fallow dead-code",
    "fallow:dupes": "npx --no-install fallow dupes",
    "fallow:health": "npx --no-install fallow health",
    "fallow:boundaries": "npx --no-install fallow dead-code --boundary-violations",
    "fallow:fix:dry-run": "npx --no-install fallow fix --dry-run",
    "skills:check": "tsx tooling/check-agent-skills.ts",
    "release:metadata": "tsx tooling/release-check.ts",
    "fmt:check": "dprint check",
    "fmt": "dprint fmt",
    "release:check": "pnpm run fmt:check && pnpm run check && pnpm run db:check && pnpm run roadmap:measure && pnpm run skills:check && pnpm run boundary:test && pnpm run boundary:lint && pnpm run test && pnpm run fallow:audit",
    "architecture:check": "tsx tooling/architecture.ts",
    "financial:gate": "tsx tooling/financial-gate.ts",
    "roadmap:measure": "tsx tooling/roadmap-completion/measure.ts",
    "boundary:lint": "ast-grep scan apps foundation modules platform runtime tooling tests && pnpm run fallow:boundaries && pnpm run architecture:check && tsx tooling/schema-ownership.ts",
    "postgres19:rehearse": "tsx tooling/postgresql-19/rehearse.ts",
    "production:artifacts": "tsx tooling/production/artifacts.ts",
    "boundary:test": "ast-grep test --skip-snapshot-tests",
    "check": "pnpm run contracts && pnpm run styles && tsc --noEmit -p tsconfig.json && pnpm --filter @ritsei/web run check"
  }
}
