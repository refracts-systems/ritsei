{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "vendor/**",
    "**/node_modules/**",
    ".auto/**",
    "**/dist/**",
    "apps/web/src/ui/generated/**",
    "apps/web/src/shared/contracts/generated/**",
    "apps/web/dist/**",
    "db/migrations/**/snapshot.json",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "tooling/oxlint/anti-slop/**"
  ],
  // Vendored anti-slop rules (tooling/oxlint/anti-slop/UPSTREAM.md). Rules left out below conflict
  // with documented repository conventions; each deviation and its reason is recorded there.
  "jsPlugins": [
    { "name": "anti-slop", "specifier": "./tooling/oxlint/anti-slop/index.ts" },
    { "name": "anti-slop-effect", "specifier": "./tooling/oxlint/anti-slop/effect/index.ts" }
  ],
  "rules": {
    "oxc/no-accumulating-spread": "error",
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop-effect/no-manual-effect-error-tag": "error",
    "anti-slop-effect/prefer-effect-match": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop-effect/no-service-constructor-imports": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-conditional-empty-object-spread": "error"
  },
  // ADR-0105: modules not yet migrated to typed service inputs. Remove each entry with its
  // module's migration; the block goes away with the last one.
  "overrides": [
    {
      "files": [
        "apps/web/src/features/accounting/**",
        "apps/web/src/features/authorization/**",
        "apps/web/src/features/identity/**",
        "apps/web/src/features/inventory/**",
        "apps/web/src/features/party/**",
        "apps/web/src/features/process-studio/**",
        "apps/web/src/features/procurement/**",
        "apps/web/src/features/product/**",
        "apps/web/src/features/sales/**",
        "apps/web/src/features/tax/**",
        "apps/web/src/shared/**",
        "erp/modules/accounting/**",
        "erp/modules/inventory/**",
        "erp/modules/process/**",
        "erp/runtime/**",
        "framework/foundation/database/**",
        "framework/foundation/document-rendering/**",
        "framework/foundation/jobs/**",
        "framework/foundation/workload/**",
        "framework/modules/authorization/**",
        "framework/modules/integrations/**",
        "framework/platform/postgres/**",
        "tests/**",
        "tooling/**"
      ],
      "rules": { "anti-slop/no-unknown-parameters": "off" }
    }
  ]
}
