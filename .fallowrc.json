{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "erp/runtime/api/mod.ts",
    "erp/runtime/auth/bootstrap.ts",
    "erp/runtime/migrator/mod.ts",
    "erp/runtime/migrator/p0-backfill.ts",
    "erp/runtime/worker/mod.ts",
    "apps/web/src/features/process-studio/index.ts",
    "apps/web/src/experiments/solid-effect/src/main.tsx",
    "apps/**/*.test.ts",
    "apps/**/*.test.tsx",
    "framework/foundation/mod.ts",
    "framework/foundation/*/mod.ts",
    "framework/foundation/**/*.test.ts",
    "framework/foundation/**/*.test.tsx",
    "framework/modules/*/mod.ts",
    "erp/modules/*/mod.ts",
    "framework/modules/**/*.test.ts",
    "erp/modules/**/*.test.ts",
    "framework/modules/**/*.test.tsx",
    "erp/modules/**/*.test.tsx",
    "framework/platform/mod.ts",
    "framework/platform/*/mod.ts",
    "framework/platform/**/*.test.ts",
    "framework/platform/**/*.test.tsx",
    "erp/runtime/**/*.test.ts",
    "erp/runtime/**/*.test.tsx",
    "tests/**/*.test.ts",
    "tests/**/*.test.tsx",
    "tooling/**/*.ts",
    "db/schema/index.ts",
    "drizzle.config.ts"
  ],
  "ignorePatterns": [
    "vendor/**",
    "db/migrations/**",
    "**/*.d.ts",
    ".auto/**",
    "tooling/oxlint/anti-slop/**"
  ],
  "ignoreDependencies": [
    "@axe-core/playwright",
    "@effect/vitest",
    "@effect/platform-node",
    "@effect/platform-node-shared",
    "@effect/sql-pg",
    "uuid",
    "effect",
    "@phosphor-icons/web",
    "jiti",
    "@oxlint/plugins",
    "magic-string"
  ],
  "ignoreExports": [
    {
      "file": "framework/modules/authorization/src/capabilities.ts",
      "exports": ["Capability"]
    },
    {
      "file": "framework/modules/authorization/src/contract.ts",
      "exports": ["Capability"]
    },
    {
      "file": "erp/modules/accounting/src/contract.ts",
      "exports": [
        "ListAccountingConfigurationsInput",
        "ListAccountsInput",
        "ListAccountingPeriodsInput",
        "ListRevenuePostingProfilesInput",
        "ListJournalEntriesInput"
      ]
    },
    {
      "file": "framework/modules/authorization/src/capabilities.ts",
      "exports": ["CapabilityScope", "CapabilityStability"]
    },
    {
      "file": "framework/modules/auth/src/contract.ts",
      "exports": ["ExternalIdentityType", "IdentityProviderShape"]
    },
    {
      "file": "erp/modules/inventory/src/contract.ts",
      "exports": ["StockMovementKind"]
    },
    {
      "file": "erp/modules/procurement/src/contract.ts",
      "exports": ["PurchaseOrderStatus"]
    }
  ],
  "rulePacks": ["./tooling/fallow/rules/ritsei-static-policy.json"],
  "rules": {
    "policy-violation": "error"
  },
  "audit": {
    "gate": "all",
    "css": false,
    "cssDeep": false,
    "deadCodeBaseline": "tooling/fallow/baselines/dead-code.json",
    "healthBaseline": "tooling/fallow/baselines/health.json",
    "dupesBaseline": "tooling/fallow/baselines/dupes.json"
  },
  "boundaries": {
    "zones": [
      {
        "name": "tests",
        "patterns": [
          "tests/**",
          "apps/**/*.test.ts",
          "apps/**/*.test.tsx",
          "framework/**/*.test.ts",
          "framework/**/*.test.tsx",
          "erp/**/*.test.ts",
          "erp/**/*.test.tsx",
          "extensions/**/*.test.ts",
          "extensions/**/*.test.tsx"
        ]
      },
      {
        "name": "configs",
        "patterns": ["*.config.ts"]
      },
      {
        "name": "apps-web-ui-public",
        "patterns": [
          "apps/web/src/ui/foundations/layout.ts",
          "apps/web/src/ui/foundations/typography.ts",
          "apps/web/src/ui/foundations/format.ts",
          "apps/web/src/ui/primitives/action-menu.tsx",
          "apps/web/src/ui/primitives/badge.tsx",
          "apps/web/src/ui/primitives/button.tsx",
          "apps/web/src/ui/primitives/dialog.tsx",
          "apps/web/src/ui/primitives/form-field.tsx",
          "apps/web/src/ui/primitives/input.tsx",
          "apps/web/src/ui/primitives/form.tsx",
          "apps/web/src/ui/primitives/money-field.tsx",
          "apps/web/src/ui/primitives/party-field.tsx",
          "apps/web/src/ui/primitives/quantity-field.tsx",
          "apps/web/src/ui/primitives/select.tsx",
          "apps/web/src/ui/primitives/tabs.tsx",
          "apps/web/src/ui/recipes/control.ts",
          "apps/web/src/ui/recipes/surface.ts",
          "apps/web/src/ui/patterns/approval-composition.tsx",
          "apps/web/src/ui/patterns/approval.tsx",
          "apps/web/src/ui/patterns/bulk-operation.tsx",
          "apps/web/src/ui/patterns/command-surface.tsx",
          "apps/web/src/ui/patterns/confirm-dialog.tsx",
          "apps/web/src/ui/patterns/entity-workspace.tsx",
          "apps/web/src/ui/patterns/exception-investigation.tsx",
          "apps/web/src/ui/patterns/filter-bar.tsx",
          "apps/web/src/ui/patterns/master-detail.tsx",
          "apps/web/src/ui/patterns/operational-workspace.tsx",
          "apps/web/src/ui/patterns/data-table.tsx",
          "apps/web/src/ui/patterns/ritsei-virtual-list.tsx",
          "apps/web/src/ui/patterns/settings.tsx",
          "apps/web/src/ui/icons/index.ts",
          "apps/web/src/ui/icons/icon.tsx",
          "apps/web/src/ui/motion/index.ts",
          "apps/web/src/ui/interaction/contract.ts",
          "apps/web/src/ui/primitives/action-menu-context.ts",
          "apps/web/src/ui/primitives/reference.tsx"
        ]
      },
      {
        "name": "apps-web-ui-bootstrap",
        "patterns": ["apps/web/src/ui/styles.ts"]
      },
      {
        "name": "apps-web-ui-internal",
        "patterns": ["apps/web/src/ui/**"]
      },
      {
        "name": "apps-web",
        "patterns": ["apps/web/**"]
      },
      {
        "name": "framework-foundation",
        "patterns": ["framework/foundation/**"]
      },
      {
        "name": "framework-platform",
        "patterns": ["framework/platform/**"]
      },
      {
        "name": "framework-modules",
        "patterns": ["framework/modules/**"]
      },
      {
        "name": "erp-runtime-adapters",
        "patterns": ["erp/runtime/adapters/**"]
      },
      {
        "name": "erp-runtime",
        "patterns": ["erp/runtime/**"]
      },
      {
        "name": "erp-modules",
        "patterns": ["erp/modules/**"]
      },
      {
        "name": "extensions",
        "patterns": ["extensions/**"]
      },
      {
        "name": "database",
        "patterns": ["db/**"]
      },
      {
        "name": "tooling",
        "patterns": ["tooling/**"]
      }
    ],
    "rules": [
      {
        "from": "tests",
        "allow": [
          "apps-web",
          "framework-foundation",
          "framework-platform",
          "framework-modules",
          "erp-runtime",
          "erp-runtime-adapters",
          "erp-modules",
          "extensions",
          "database",
          "tooling",
          "configs",
          "apps-web-ui-public",
          "apps-web-ui-internal",
          "apps-web-ui-bootstrap"
        ]
      },
      {
        "from": "configs",
        "allow": ["tooling"]
      },
      {
        "from": "apps-web-ui-public",
        "allow": ["apps-web-ui-internal"]
      },
      {
        "from": "apps-web-ui-bootstrap",
        "allow": ["apps-web-ui-internal"]
      },
      {
        "from": "apps-web-ui-internal",
        "allow": ["apps-web-ui-public"]
      },
      {
        "from": "apps-web",
        "allow": [
          "framework-modules",
          "erp-modules",
          "framework-foundation",
          "apps-web-ui-public",
          "apps-web-ui-bootstrap"
        ]
      },
      {
        "from": "framework-foundation",
        "allow": ["framework-foundation"]
      },
      {
        "from": "framework-platform",
        "allow": ["framework-platform", "framework-foundation", "framework-modules"]
      },
      {
        "from": "framework-modules",
        "allow": ["framework-modules", "framework-foundation", "database"]
      },
      {
        "from": "erp-modules",
        "allow": ["erp-modules", "framework-modules", "framework-foundation", "database"]
      },
      {
        "from": "erp-runtime-adapters",
        "allow": [
          "erp-runtime",
          "erp-modules",
          "framework-foundation",
          "framework-platform",
          "framework-modules",
          "database"
        ]
      },
      {
        "from": "erp-runtime",
        "allow": [
          "erp-runtime-adapters",
          "erp-runtime",
          "erp-modules",
          "framework-foundation",
          "framework-platform",
          "framework-modules",
          "database",
          "tooling"
        ]
      },
      {
        "from": "extensions",
        "allow": ["framework-modules", "framework-foundation", "erp-modules", "database"]
      },
      {
        "from": "database",
        "allow": ["database"]
      },
      {
        "from": "tooling",
        "allow": [
          "tooling",
          "erp-runtime",
          "framework-foundation",
          "framework-platform",
          "framework-modules",
          "erp-modules",
          "database"
        ]
      }
    ],
    "coverage": {
      "requireAllFiles": true
    }
  }
}
