{
  "name": "@ritsei/web",
  "private": true,
  "type": "module",
  "dependencies": {
    "@dnd-kit/solid": "0.5.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/pretendard": "5.3.0",
    "@phosphor-icons/web": "2.1.2",
    "motion": "13.2.0",
    "solid-js": "2.0.0-rc.6",
    "@solidjs/web": "2.0.0-rc.6",
    "@solidjs/router": "2.0.0-next.21",
    "@tanstack/solid-query": "6.0.0-rc.2"
  },
  "devDependencies": {
    "@kobalte/core": "2.0.0-alpha.1",
    "@solidjs/vite-plugin": "3.0.0-next.38",
    "@pandacss/dev": "1.12.0",
    "boneyard-js": "1.10.0",
    "storybook": "11.0.0-alpha.0",
    "storybook-solidjs-vite": "11.0.0-next-20260903183420",
    "tsx": "4.23.15"
  },
  "scripts": {
    "styles": "panda codegen && panda cssgen --outfile src/ui/generated/styles.css",
    "contracts": "tsx ../../tooling/frontend/contracts.ts",
    "check": "pnpm run contracts && pnpm run styles && tsc --noEmit -p tsconfig.json",
    "build": "pnpm run check && vite build",
    "dev": "pnpm run contracts && pnpm run styles && vite",
    "compatibility": "tsx ../../tooling/frontend/compatibility.ts",
    "storybook": "storybook dev --config-dir .storybook",
    "storybook:build": "storybook build --config-dir .storybook --output-dir dist/storybook",
    "browser:install": "playwright install chromium"
  }
}
