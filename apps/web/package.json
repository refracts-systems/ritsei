{
  "name": "@ritsei/web",
  "private": true,
  "type": "module",
  "scripts": {
    "styles": "panda codegen && panda cssgen --outfile src/ui/generated/styles.css",
    "contracts": "varlock run --path ../.. -- tsx ../../tooling/frontend/contracts.ts",
    "check": "varlock run --path ../.. -- pnpm run contracts && varlock run --path ../.. -- pnpm run styles && varlock run --path ../.. -- tsc --noEmit -p tsconfig.json",
    "build": "varlock run --path ../.. -- pnpm run check && varlock run --path ../.. -- vite build",
    "dev": "varlock run --path ../.. -- pnpm run contracts && varlock run --path ../.. -- pnpm run styles && varlock run --path ../.. -- vite",
    "storybook": "varlock run --path ../.. -- storybook dev --config-dir .storybook",
    "storybook:build": "varlock run --path ../.. -- storybook build --config-dir .storybook --output-dir dist/storybook",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/pretendard": "5.3.0",
    "@solidjs/router": "2.0.0-next.41",
    "@solidjs/web": "2.0.0-rc.16",
    "@tanstack/solid-query": "6.0.0-rc.5",
    "motion": "13.2.0",
    "solid-js": "2.0.0-rc.16"
  },
  "devDependencies": {
    "@kobalte/core": "2.0.0-alpha.4",
    "@pandacss/dev": "1.12.0",
    "@pandacss/preset-panda": "1.12.0",
    "@phosphor-icons/web": "2.1.2",
    "@solidjs/vite-plugin": "3.0.0-next.51",
    "@varlock/vite-integration": "1.5.4",
    "storybook": "11.0.0-alpha.0",
    "storybook-solidjs-vite": "11.0.0-next-20260903183420",
    "tsx": "4.23.15"
  },
  "varlock": {
    "loadPath": "../../.env.schema"
  }
}
