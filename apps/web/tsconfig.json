{
  "compilerOptions": {
    "target": "esnext",
    "noEmit": true,
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": [
    "src/main.tsx",
    "src/app/**/*",
    "src/shared/**/*",
    "src/ui/**/*",
    "src/features/identity/**/*",
    "vite.config.ts"
  ],
  "exclude": ["src/**/*.test.ts"]
}
