# This file is the committed Varlock schema and local development baseline.
# Put secrets and machine-specific overrides in the ignored .env.local file.
# See https://varlock.dev for schema syntax and secure secret providers.
# @defaultRequired=infer @defaultSensitive=false
# ---

# @optional @sensitive @example="postgresql://postgres:postgres@127.0.0.1:5433/ritsei" @type=url(allowedProtocols=[postgres, postgresql])
DATABASE_URL=
# Compose services use the internal PostgreSQL hostname rather than the host port.
# @required @sensitive @auditIgnore @type=url(allowedProtocols=[postgres, postgresql])
RITSEI_ENTRY_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ritsei

# @type=port
PORT=8000

# @auditIgnore @type=enum(entry, standard, scale, enterprise)
RITSEI_DEPLOYMENT_PROFILE=entry
# @auditIgnore @type=enum(postgresql, tigerbeetle)
RITSEI_FINANCIAL_AUTHORITY=postgresql
# Local development uses an explicit transitional session profile.
# @auditIgnore @type=enum(transitional-local, oidc)
RITSEI_AUTH_PROFILE=transitional-local

# @auditIgnore @type=email
RITSEI_TRANSITIONAL_USER_ACCOUNT_EMAIL=admin@example.test
# @auditIgnore @optional
RITSEI_TRANSITIONAL_USER_ACCOUNT_ID=

# Run `pnpm run auth:bootstrap` once to create the local account, tenant, memberships, and ERP baseline.
# @auditIgnore @optional @type=email
RITSEI_BOOTSTRAP_EMAIL=
# @auditIgnore @optional
RITSEI_BOOTSTRAP_TENANT_SLUG=
# @auditIgnore @optional
RITSEI_BOOTSTRAP_TIMEZONE=
# @auditIgnore @optional
RITSEI_BOOTSTRAP_ORGANIZATION_NAME=
# @auditIgnore @optional
RITSEI_BOOTSTRAP_BRANCH_NAME=
# @auditIgnore @optional
RITSEI_BOOTSTRAP_BRANCH_TIMEZONE=
# @auditIgnore @optional
RITSEI_BOOTSTRAP_LOCAL_TAX_REGISTRATION=
# @auditIgnore @optional
RITSEI_BOOTSTRAP_DEDICATED_JOURNAL_CODE=
# @auditIgnore @optional
RITSEI_BOOTSTRAP_WAREHOUSE_NAME=
# @auditIgnore @optional
RITSEI_BOOTSTRAP_BASE_CURRENCY=
# @auditIgnore @optional @type=number(isInt=true, min=1, max=12)
RITSEI_BOOTSTRAP_FISCAL_YEAR_START_MONTH=
# @auditIgnore @optional @type=boolean
RITSEI_BOOTSTRAP_POSTING_ENABLED=
# @auditIgnore @optional @type=url
RITSEI_BOOTSTRAP_EXTERNAL_ISSUER=
# @auditIgnore @optional
RITSEI_BOOTSTRAP_EXTERNAL_SUBJECT=

# Production OIDC profile requires all values below.
# @auditIgnore @optional @type=url
RITSEI_OIDC_ISSUER_URL=
# @auditIgnore @optional
RITSEI_OIDC_AUDIENCE=
# @auditIgnore @optional
RITSEI_OIDC_CLIENT_ID=
# @auditIgnore @optional @type=url
RITSEI_OIDC_AUTHORIZATION_ENDPOINT=
# @auditIgnore @optional @type=url
RITSEI_OIDC_TOKEN_ENDPOINT=
# @auditIgnore @optional @type=url
RITSEI_OIDC_JWKS_URI=
# @auditIgnore @optional @type=url
RITSEI_OIDC_REDIRECT_URI=
# @auditIgnore @optional
RITSEI_OIDC_SCOPES=

# PostgreSQL 19 replica read-your-writes is disabled until a reviewed standby is configured.
# @auditIgnore @type=boolean
RITSEI_POSTGRES_RYW_ENABLED=false
# @auditIgnore @optional @type=url(allowedProtocols=[postgres, postgresql])
POSTGRES_REPLICA_URL=
# @auditIgnore @optional
RITSEI_POSTGRES_PLACEMENT_ID=
# @auditIgnore @optional @sensitive
RITSEI_POSTGRES_CONSISTENCY_SECRET=
# @auditIgnore @optional @type=number(isInt=true, min=0)
RITSEI_POSTGRES_RYW_MAX_WAIT_MS=
# @auditIgnore @optional @type=number(isInt=true, min=0)
RITSEI_POSTGRES_CONSISTENCY_TTL_MS=

# Set TIGERBEETLE_* only when RITSEI_FINANCIAL_AUTHORITY=tigerbeetle.
# @optional @type=boolean
TIGERBEETLE_INTEGRATION=
# @optional @type=number(isInt=true, min=0)
TIGERBEETLE_CLUSTER_ID=
# @optional
TIGERBEETLE_REPLICA_ADDRESSES=
# @optional @type=number(isInt=true, min=0)
TIGERBEETLE_LEDGER=
# @optional @type=number(isInt=true, min=0)
TIGERBEETLE_CODE=
# @optional
TIGERBEETLE_CURRENCY=

# Runtime worker and maintenance commands.
# @type=string
WORKER_TENANT_ID=00000000-0000-4000-8000-000000000001
# @type=string
WORKER_ID=accounting-worker-local
# Compose uses a distinct worker identity for the entry deployment.
# @required @auditIgnore
RITSEI_ENTRY_WORKER_ID=entry-accounting-worker
# @optional
P0_BACKFILL_FILE=

# Disposable PostgreSQL 19 rehearsal settings. These are intentionally not used by normal runtime commands.
# @optional @sensitive @type=url(allowedProtocols=[postgres, postgresql])
RITSEI_DISPOSABLE_DATABASE_URL=
# @optional
RITSEI_CONFIRM_DISPOSABLE_DATABASE=
# @optional
RITSEI_POSTGRES19_EVIDENCE_PATH=

# Release tooling receives these from CI or the local shell.
# @optional
RELEASE_TAG=
# @optional
RELEASE_EXPECTED_TARGET=
# @optional
RELEASE_BASE_REF=
# @optional
RELEASE_NOTES_REF=
# @optional
GITHUB_REF_NAME=
